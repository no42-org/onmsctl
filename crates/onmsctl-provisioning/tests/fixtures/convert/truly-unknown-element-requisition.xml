<?xml version="1.0" encoding="UTF-8"?>
<!--
  Edge-case fixture: an element name the migrator's typed DTOs
  don't model (`<future-extension>`). Verifies the Option B /
  full-passthrough contract:

    XML DTOs carry an `Extras` (`#[serde(flatten)]`) field that
    captures any unclaimed attribute or child element. The
    convert pipeline projects these into the
    `metadata.x-onmsctl-unmodeled` annotation on the emitted YAML
    and emits one PR001 finding per stripped key.

  The integration test asserts the PASSTHROUGH behavior as a
  contract — `<future-extension>` now flows through to the
  annotation under `nodes.web01.future-extension` (a Mapping with
  the element's attributes), and PR001 fires for the operator to
  audit.
-->
<model-import foreign-source="future-fs">
  <node foreign-id="web01" node-label="web01">
    <interface ip-addr="10.0.0.1" snmp-primary="P"/>
    <category name="Production"/>
    <future-extension key="hypothetical" value="some-value"/>
  </node>
</model-import>
