{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventSourceLocal",
  "description": "The kubectl-style document the user authors. Validated at load time.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "spec": {
      "$ref": "#/$defs/EventSourceSpec"
    }
  },
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "$defs": {
    "AlarmDataDef": {
      "type": "object",
      "properties": {
        "alarmType": {
          "description": "Alarm semantic. Must be one of:\n  - `1` — Problem: raises an alarm, paired with a Resolution event\n  - `2` — Resolution: clears a paired Problem alarm by `reductionKey`\n  - `3` — Unresolvable: a Problem-class event with no auto-clear from\n    the device. Common for hardware-failure traps. Requires manual\n    close or an alarmd cleanup policy.",
          "type": "integer",
          "format": "int32"
        },
        "autoClean": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "clearKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "reductionKey": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "reductionKey",
        "alarmType"
      ]
    },
    "AutoackDef": {
      "type": "object",
      "properties": {
        "state": {
          "description": "\"on\" or \"off\".",
          "type": "string"
        },
        "text": {
          "description": "Maps to `content` on the wire.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "state"
      ]
    },
    "CorrelationDef": {
      "type": "object",
      "properties": {
        "cmax": {
          "type": [
            "string",
            "null"
          ]
        },
        "cmin": {
          "type": [
            "string",
            "null"
          ]
        },
        "cuei": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "state"
      ]
    },
    "DecodeDef": {
      "type": "object",
      "properties": {
        "label": {
          "description": "The human-readable label. Maps to `varbinddecodedstring` on the wire.",
          "type": "string"
        },
        "value": {
          "description": "The raw varbind value being annotated. Maps to `varbindvalue` on\nthe wire (an XSD attribute on `<decode>`).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ]
    },
    "EventDef": {
      "type": "object",
      "properties": {
        "alarmData": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlarmDataDef"
            },
            {
              "type": "null"
            }
          ]
        },
        "autoacknowledge": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutoackDef"
            },
            {
              "type": "null"
            }
          ]
        },
        "correlation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CorrelationDef"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "logmsg": {
          "anyOf": [
            {
              "$ref": "#/$defs/LogmsgDef"
            },
            {
              "type": "null"
            }
          ]
        },
        "mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaskDef"
            },
            {
              "type": "null"
            }
          ]
        },
        "mouseovertext": {
          "type": [
            "string",
            "null"
          ]
        },
        "operinstruct": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "type": "string"
        },
        "tticket": {
          "anyOf": [
            {
              "$ref": "#/$defs/TticketDef"
            },
            {
              "type": "null"
            }
          ]
        },
        "uei": {
          "type": "string"
        },
        "varbindsdecode": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/VarbindsdecodeDef"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "uei",
        "label",
        "severity"
      ]
    },
    "EventSourceSpec": {
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Defaults to `true` when absent.",
          "type": "boolean",
          "default": true
        },
        "events": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/EventDef"
          }
        }
      },
      "additionalProperties": false
    },
    "LogmsgDef": {
      "type": "object",
      "properties": {
        "dest": {
          "type": "string"
        },
        "notify": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "text": {
          "description": "Human-readable substitution template. Maps to `content` on the wire.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "dest",
        "text"
      ]
    },
    "MaskDef": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MaskElementDef"
          }
        },
        "varbinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MaskVarbindDef"
          }
        }
      },
      "additionalProperties": false
    },
    "MaskElementDef": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Element name. Maps to `mename` on the wire.",
          "type": "string"
        },
        "values": {
          "description": "Match values. Maps to `mevalues` on the wire.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "MaskVarbindDef": {
      "type": "object",
      "properties": {
        "values": {
          "description": "Match values. Maps to `vbvalues` on the wire.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "vbnumber": {
          "description": "Match the SNMP trap PDU's varbind by 1-indexed position. Mutually\nexclusive with [`vboid`]; the validator enforces exactly one is set.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "vboid": {
          "description": "Match the SNMP trap PDU's varbind by OID (e.g. `.1.3.6.1.4.1.61509.1.2.0`).\nMutually exclusive with [`vbnumber`].",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "TticketDef": {
      "type": "object",
      "properties": {
        "state": {
          "description": "\"on\" or \"off\".",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "state"
      ]
    },
    "VarbindsdecodeDef": {
      "type": "object",
      "properties": {
        "decode": {
          "description": "Value→label mappings rendered in the Horizon event UI.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DecodeDef"
          }
        },
        "parmid": {
          "description": "Identifies which event parameter this decode group annotates.\nString-typed per the eventconf XSD; typical values are numeric.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "parmid",
        "decode"
      ]
    }
  }
}
