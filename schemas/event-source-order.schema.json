{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventSourceOrderLocal",
  "description": "An `EventSourceOrder` document: which event sources are evaluated first.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "spec": {
      "$ref": "#/$defs/EventSourceOrderSpec"
    }
  },
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "$defs": {
    "EventSourceOrderSpec": {
      "type": "object",
      "properties": {
        "first": {
          "description": "Sources evaluated first, in this order. Every other source keeps its\ncurrent relative order below them.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "first"
      ]
    },
    "Metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    }
  }
}
