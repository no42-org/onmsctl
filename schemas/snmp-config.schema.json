        },
        "readCommunity": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "retries": {
          "description": "Friendly alias for the wire's `retry`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "securityLevel": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecurityLevel"
            },
            {
              "type": "null"
            }
          ]
        },
        "securityName": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "ttl": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "version": {
          "description": "`v1` / `v2c` / `v3`.",
          "type": [
            "string",
            "null"
          ]
        },
        "writeCommunity": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ProfileLocal": {
      "description": "A named parameter template. `label` is required.",
      "type": "object",
      "properties": {
        "authPassphrase": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "authProtocol": {
          "type": [
            "string",
            "null"
          ]
        },
        "contextEngineId": {
          "type": [
            "string",
            "null"
          ]
        },
        "contextName": {
          "type": [
            "string",
            "null"
          ]
        },
        "engineId": {
          "type": [
            "string",
            "null"
          ]
        },
        "enterpriseId": {
          "type": [
            "string",
            "null"
          ]
        },
        "filterExpression": {
          "description": "OpenNMS filter expression (wire `filter`).",
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "maxRepetitions": {
          "type": [
            "integer",
            "null"
          ],
